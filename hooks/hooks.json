{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/writing-core/SKILL.md",
              "${CLAUDE_PLUGIN_ROOT}/skills/writing-conversation/SKILL.md"
            ],
            "statusMessage": "Loading writing core"
          }
        ]
      }
    ]
  }
}
